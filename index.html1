<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#1D5E8C">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Прайс">
<meta name="mobile-web-app-capable" content="yes">
<title>Прайс магазина</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap">
<style>
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0}

/* Layout: sticky header (title, search, brand tabs, stock filter) over a flat list of price rows grouped by section; edit sheet slides up from the bottom. */
:root{
  --bg:#F3F5F7; --surface:#FFFFFF; --fg:#14212B; --muted:#65727E; --line:#E0E5EA;
  --accent:#1D5E8C; --accent-fg:#FFFFFF;
  --ok:#17803F; --ok-bg:#E2F4E9; --bad:#C62828; --bad-bg:#FCE7E7;
  --font-body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --font-head:'Manrope','Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1418; --surface:#172027; --fg:#E7EDF1; --muted:#8C9CA8; --line:#26323B;
    --accent:#6DB2E3; --accent-fg:#0E1418;
    --ok:#5DCB8B; --ok-bg:#16332A; --bad:#FF8F86; --bad-bg:#3B1F21;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1418; --surface:#172027; --fg:#E7EDF1; --muted:#8C9CA8; --line:#26323B;
  --accent:#6DB2E3; --accent-fg:#0E1418;
  --ok:#5DCB8B; --ok-bg:#16332A; --bad:#FF8F86; --bad-bg:#3B1F21;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--fg); font-family:var(--font-body); font-size:15px; line-height:1.35;
  padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:0 96px;
}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;-webkit-tap-highlight-color:transparent}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

#top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);padding-top:12px;padding-bottom:8px;max-width:760px;margin:0 auto}
.bar{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:10px}
h1{font-family:var(--font-head);font-weight:800;font-size:22px;margin:0;letter-spacing:-.01em}
#stamp{font-size:12.5px;color:var(--muted);text-align:right;font-variant-numeric:tabular-nums}
#q{width:100%;height:44px;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:0 14px;font-size:16px}
#q::placeholder{color:var(--muted)}
#tabs{display:flex;gap:8px;overflow-x:auto;padding:10px 0 2px;scrollbar-width:none}
#tabs::-webkit-scrollbar{display:none}
.tab{flex:none;height:38px;padding:0 14px;border-radius:19px;border:1px solid var(--line);background:var(--surface);font-weight:600;font-size:14px;white-space:nowrap}
.tab[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
#seg{display:flex;gap:6px;padding-top:8px}
.seg{height:32px;padding:0 12px;border-radius:8px;border:1px solid transparent;background:transparent;color:var(--muted);font-size:13.5px;font-weight:500}
.seg[aria-pressed="true"]{background:var(--surface);border-color:var(--line);color:var(--fg);font-weight:600}
.seg b{font-weight:700;font-variant-numeric:tabular-nums}
.seg.bad[aria-pressed="true"] b{color:var(--bad)}

#list{max-width:760px;margin:0 auto}
.sec{font-family:var(--font-head);font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:22px 0 8px}
.group{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.row{display:flex;align-items:center;gap:10px;padding:0 10px 0 0;border-top:1px solid var(--line);min-height:64px}
.row:first-child{border-top:0}
.main{flex:1;min-width:0;text-align:left;background:none;border:0;padding:10px 0 10px 14px;display:flex;flex-direction:column;gap:3px;align-self:stretch;justify-content:center}
.name{font-weight:600;font-size:15px;overflow-wrap:anywhere}
.meta{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.mem{font-weight:600;color:var(--fg);background:var(--bg);border-radius:6px;padding:1px 7px}
.prices{flex:none;display:grid;grid-template-columns:auto auto;gap:1px 6px;align-items:baseline;font-variant-numeric:tabular-nums}
.prices i{font-style:normal;font-size:11px;color:var(--muted);text-align:right}
.prices b{font-family:var(--font-head);font-weight:700;font-size:15px;text-align:right;white-space:nowrap}
.stock{flex:none;width:62px;height:40px;border-radius:10px;border:0;font-weight:700;font-size:14px;background:var(--ok-bg);color:var(--ok)}
.row.out{background:var(--bad-bg)}
.row.out .name,.row.out .prices b{color:var(--bad)}
.row.out .stock{background:var(--bad);color:var(--bad-bg)}
.row.out .mem{background:var(--surface)}

#msg{margin:40px 0;text-align:center;color:var(--muted);max-width:420px;margin-inline:auto}
#msg strong{display:block;color:var(--fg);font-family:var(--font-head);font-size:17px;margin-bottom:6px}

#add{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));height:52px;padding:0 20px;border-radius:26px;border:0;background:var(--accent);color:var(--accent-fg);font-weight:700;font-size:15px;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:15}

#sheet{position:fixed;inset:0;z-index:40;background:rgba(10,16,20,.5);display:flex;align-items:flex-end;justify-content:center}
.panel{width:100%;max-width:520px;max-height:92%;overflow:auto;background:var(--surface);border-radius:16px 16px 0 0;padding:18px max(16px,env(safe-area-inset-left,0px)) calc(18px + env(safe-area-inset-bottom,0px))}
.panel h2{font-family:var(--font-head);font-size:18px;margin:0 0 14px}
.f{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.f label{font-size:12.5px;color:var(--muted);font-weight:500}
.f input,.f select{height:46px;border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:0 12px;font-size:16px;width:100%}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tog{display:flex;gap:8px;margin-bottom:16px}
.tog button{flex:1;height:44px;border-radius:10px;border:1px solid var(--line);background:var(--bg);font-weight:700}
.tog button[aria-pressed="true"].y{background:var(--ok-bg);color:var(--ok);border-color:var(--ok)}
.tog button[aria-pressed="true"].n{background:var(--bad-bg);color:var(--bad);border-color:var(--bad)}
.acts{display:flex;gap:10px}
.acts button{height:48px;border-radius:12px;border:1px solid var(--line);background:var(--bg);font-weight:600;padding:0 16px}
.acts .save{flex:1;background:var(--accent);border-color:var(--accent);color:var(--accent-fg);font-weight:700}
.acts .del{color:var(--bad)}
.acts .del.sure{background:var(--bad);color:var(--bad-bg);border-color:var(--bad)}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom,0px));max-width:min(92%,420px);background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;z-index:60;text-align:center}
@media (max-width:360px){.prices b{font-size:14px}.stock{width:56px}}

#gate{position:fixed;inset:0;z-index:80;background:var(--bg);display:flex;align-items:center;justify-content:center;padding:24px}
#gate form{width:100%;max-width:340px;display:flex;flex-direction:column;gap:12px}
#gate h2{font-family:var(--font-head);font-size:22px;margin:0}
#gate p{margin:0;color:var(--muted)}
#gate input{height:50px;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:0 14px;font-size:18px;width:100%}
#gate button{height:50px;border:0;border-radius:12px;background:var(--accent);color:var(--accent-fg);font-weight:700;font-size:16px}
#gErr{color:var(--bad);min-height:1.35em;font-size:14px}

</style>
</head>
<body>
<header id="top">
  <div class="bar"><h1>Прайс</h1><span id="stamp">Загрузка…</span></div>
  <input id="q" type="search" placeholder="Поиск: 17 pro 256, A57, Алиса" autocomplete="off" enterkeyhint="search" aria-label="Поиск по прайсу">
  <nav id="tabs" aria-label="Бренды"></nav>
  <div id="seg" role="group" aria-label="Фильтр по наличию">
    <button class="seg" id="sAll" aria-pressed="true">Все</button>
    <button class="seg" id="sIn" aria-pressed="false">В наличии</button>
    <button class="seg bad" id="sOut" aria-pressed="false">Нет <b id="cOut">0</b></button>
  </div>
</header>

<main id="list"></main>
<button id="add" aria-label="Добавить товар">+ Товар</button>

<div id="sheet" hidden>
  <div class="panel" role="dialog" aria-modal="true" aria-labelledby="shT">
    <h2 id="shT">Товар</h2>
    <div class="f"><label for="fName">Модель</label><input id="fName" type="text" autocomplete="off"></div>
    <div class="two">
      <div class="f"><label for="fMem">Память</label><input id="fMem" type="text" autocomplete="off" placeholder="256, 12/512"></div>
      <div class="f"><label for="fSec">Раздел</label><select id="fSec"></select></div>
    </div>
    <div class="f" id="newSecBox" hidden><label for="fNewSec">Название нового раздела</label><input id="fNewSec" type="text" autocomplete="off"></div>
    <div class="two">
      <div class="f"><label for="fBank">Цена банк, ₸</label><input id="fBank" type="text" inputmode="numeric" autocomplete="off"></div>
      <div class="f"><label for="fCash">Цена нал, ₸</label><input id="fCash" type="text" inputmode="numeric" autocomplete="off"></div>
    </div>
    <div class="tog" role="group" aria-label="Наличие">
      <button class="y" id="tY" type="button">Есть</button>
      <button class="n" id="tN" type="button">Нет</button>
    </div>
    <div class="acts">
      <button class="del" id="bDel" type="button">Удалить</button>
      <button id="bCancel" type="button">Отмена</button>
      <button class="save" id="bSave" type="button">Сохранить</button>
    </div>
  </div>
</div>
<div id="toast" hidden role="status"></div>


<div id="gate" hidden>
  <form id="gForm" autocomplete="off">
    <h2>Код доступа</h2>
    <p>Введите код один раз, телефон его запомнит.</p>
    <input id="gPin" type="password" inputmode="text" autocomplete="off" aria-label="Код доступа">
    <div id="gErr" role="alert"></div>
    <button type="submit">Войти</button>
  </form>
</div>

<script>
(function(){
  // ===== НАСТРОЙКА: вставьте адрес проекта и публичный ключ из Supabase (Project Settings → API) =====
  var SUPABASE_URL = "https://nlodwjhcncsxkrfyzxpv.supabase.co";
  var SUPABASE_KEY = "sb_publishable_rLllAZ2Yy3OFMs0DwInJVQ_PSz9T43Y";
  // ====================================================================================================

  var TAB_ORDER=["Apple","Samsung","Xiaomi и др.","Алиса и прочее"];
  var items=[], tab=null, filter="all", query="", loaded=false, errText="";
  var editing=null, delArmed=false, stockDraft=true, pending=0;
  var pin="";
  var $=function(id){return document.getElementById(id)};

  function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
  function fmt(n){return Number(n||0).toLocaleString("ru-RU")}
  function p2(n){return String(n).padStart(2,"0")}
  function fdate(ms){
    if(!ms)return "";
    var d=new Date(ms),s=p2(d.getDate())+"."+p2(d.getMonth()+1)+" "+p2(d.getHours())+":"+p2(d.getMinutes());
    if(d.getFullYear()!==new Date().getFullYear())s=p2(d.getDate())+"."+p2(d.getMonth()+1)+"."+d.getFullYear()+" "+p2(d.getHours())+":"+p2(d.getMinutes());
    return s;
  }
  function norm(s){return String(s||"").toLowerCase().replace(/[^a-z0-9а-яё+]/g,"")}
  function num(s){var n=parseInt(String(s).replace(/\D/g,""),10);return isNaN(n)?0:n}
  function store(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}
  pin=store("pin")||"";

  // ---------- data layer (Supabase REST, no libraries) ----------
  function configured(){return SUPABASE_URL.indexOf("PASTE_")<0&&SUPABASE_KEY.indexOf("PASTE_")<0}
  function rpc(fn,args){
    args=args||{};args.p_pin=pin;
    var h={apikey:SUPABASE_KEY,"Content-Type":"application/json"};
    if(SUPABASE_KEY.indexOf("eyJ")===0)h.Authorization="Bearer "+SUPABASE_KEY;
    return fetch(SUPABASE_URL.replace(/\/$/,"")+"/rest/v1/rpc/"+fn,{method:"POST",headers:h,body:JSON.stringify(args)}).then(function(r){
      return r.text().then(function(t){
        var j=null;try{j=t?JSON.parse(t):null}catch(e){}
        if(!r.ok){
          var m=(j&&(j.message||j.hint))||("HTTP "+r.status),e=new Error(m);
          e.badPin=String(m).indexOf("bad pin")>=0;
          throw e;
        }
        return j;
      });
    });
  }
  function mapRow(r){
    return {id:r.id,tab:r.tab,section:r.section,name:r.name,mem:r.mem||"",bank:+r.bank||0,cash:+r.cash||0,
      inStock:r.in_stock!==false,updated:Date.parse(r.updated_at)||0,ord:+r.ord||0};
  }
  function load(){
    if(!configured()){errText="В файле index.html не заполнены адрес и ключ Supabase (две строки в начале скрипта).";render();return Promise.resolve()}
    return rpc("price_list",{}).then(function(rows){
      items=(rows||[]).map(mapRow);loaded=true;errText="";$("gate").hidden=true;render();
    }).catch(function(e){
      if(e.badPin){showGate(pin?"Неверный код":"");return}
      if(!loaded){errText="Не удалось загрузить прайс. Проверьте интернет и настройки Supabase.";render()}
      else toast("Нет связи. Показан последний загруженный прайс.");
    });
  }
  function payload(i){return {id:i.id,tab:i.tab,section:i.section,name:i.name,mem:i.mem,bank:i.bank,cash:i.cash,inStock:i.inStock,ord:i.ord}}
  var queue={};
  function persist(id,fn){
    pending++;
    var p=(queue[id]||Promise.resolve()).then(fn).catch(function(e){
      if(e&&e.badPin){showGate("Неверный код")}else toast("Не удалось сохранить. Проверьте связь и повторите.");
      pending=Math.max(0,pending-1);return load().then(function(){return "fail"});
    }).then(function(r){if(r!=="fail")pending=Math.max(0,pending-1)});
    queue[id]=p;return p;
  }
  function find(id){for(var k=0;k<items.length;k++)if(items[k].id===id)return items[k];return null}
  function mutate(id,patch){
    var it=find(id);if(!it)return;
    Object.keys(patch).forEach(function(k){it[k]=patch[k]});
    it.updated=Date.now();render();
    var snap=payload(it);
    persist(id,function(){return rpc("price_save",{p_item:snap})});
  }
  function createItem(rec){
    var it={id:"n"+Date.now().toString(36)+Math.random().toString(36).slice(2,5),tab:rec.tab,section:rec.section,name:rec.name,mem:rec.mem,bank:rec.bank,cash:rec.cash,inStock:rec.inStock,ord:rec.ord,updated:Date.now()};
    items.push(it);render();
    var snap=payload(it);
    persist(it.id,function(){return rpc("price_save",{p_item:snap})});
  }
  function removeItem(id){
    items=items.filter(function(i){return i.id!==id});render();
    persist(id,function(){return rpc("price_delete",{p_id:id})});
  }

  // ---------- gate (access code) ----------
  function showGate(err){
    $("gate").hidden=false;$("gErr").textContent=err||"";$("gPin").value="";
    setTimeout(function(){$("gPin").focus()},50);
  }
  $("gForm").addEventListener("submit",function(e){
    e.preventDefault();pin=$("gPin").value;store("pin",pin);load();
  });

  // ---------- list ----------
  function tabList(){
    var seen={},out=[];
    items.forEach(function(i){if(i.tab&&!seen[i.tab]){seen[i.tab]=1;out.push(i.tab)}});
    out.sort(function(a,b){
      var x=TAB_ORDER.indexOf(a),y=TAB_ORDER.indexOf(b);
      if(x<0)x=99;if(y<0)y=99;
      return x-y||a.localeCompare(b,"ru");
    });
    return out;
  }
  function sectionsOf(t){
    var m={};
    items.forEach(function(i){if(i.tab===t){var o=m[i.section];m[i.section]=o===undefined?i.ord:Math.min(o,i.ord)}});
    return Object.keys(m).sort(function(a,b){return m[a]-m[b]});
  }
  function matches(i,tokens){
    var hay=norm(i.name+" "+(i.mem||"")+" "+(i.section||"")+" "+i.tab);
    for(var k=0;k<tokens.length;k++){if(hay.indexOf(tokens[k])<0)return false}
    return true;
  }
  function msg(t,s){var d=el("div");d.id="msg";d.appendChild(el("strong",null,t));if(s)d.appendChild(document.createTextNode(s));return d}

  function render(){
    var last=0;items.forEach(function(i){if(i.updated>last)last=i.updated});
    $("stamp").textContent=last?("Обновлено "+fdate(last)):(loaded?"":"Загрузка…");

    var tl=tabList();
    if(tl.length&&(!tab||tl.indexOf(tab)<0))tab=tl.indexOf(store("tab"))>=0?store("tab"):tl[0];
    var nav=$("tabs");nav.textContent="";
    tl.forEach(function(t){
      var b=el("button","tab",t);b.type="button";b.setAttribute("aria-pressed",String(!query&&t===tab));
      b.onclick=function(){tab=t;store("tab",t);$("q").value="";query="";render();window.scrollTo(0,0)};
      nav.appendChild(b);
    });

    var scope=items.filter(function(i){return query?true:i.tab===tab});
    var tokens=query.split(/\s+/).map(norm).filter(Boolean);
    if(query)scope=scope.filter(function(i){return matches(i,tokens)});
    $("cOut").textContent=scope.filter(function(i){return !i.inStock}).length;
    $("sAll").setAttribute("aria-pressed",String(filter==="all"));
    $("sIn").setAttribute("aria-pressed",String(filter==="in"));
    $("sOut").setAttribute("aria-pressed",String(filter==="out"));
    var shown=scope.filter(function(i){return filter==="all"||(filter==="in"?i.inStock:!i.inStock)});

    var list=$("list");list.textContent="";
    if(errText){list.appendChild(msg("Нет связи с данными",errText));return}
    if(!loaded){list.appendChild(msg("Загружаю прайс…",""));return}
    if(!items.length){list.appendChild(msg("Прайс пока пустой","Нажмите «+ Товар», чтобы добавить первую позицию."));return}
    if(!shown.length){list.appendChild(msg("Ничего не найдено",query?"Попробуйте другое слово или номер модели.":"В этом разделе нет подходящих товаров."));return}

    var groups=[],gi={};
    shown.sort(function(a,b){
      if(query){var x=TAB_ORDER.indexOf(a.tab),y=TAB_ORDER.indexOf(b.tab);if(x!==y)return (x<0?99:x)-(y<0?99:y)}
      return a.ord-b.ord;
    });
    shown.forEach(function(i){
      var key=query?(i.tab+" · "+i.section):i.section;
      if(!gi[key]){gi[key]={title:key,rows:[]};groups.push(gi[key])}
      gi[key].rows.push(i);
    });
    groups.forEach(function(g){
      list.appendChild(el("div","sec",g.title));
      var box=el("div","group");
      g.rows.forEach(function(i){box.appendChild(rowEl(i))});
      list.appendChild(box);
    });
  }

  function rowEl(i){
    var r=el("div","row"+(i.inStock?"":" out"));
    var m=el("button","main");m.type="button";
    m.appendChild(el("span","name",i.name));
    var meta=el("span","meta");
    if(i.mem)meta.appendChild(el("span","mem",i.mem));
    if(i.updated)meta.appendChild(el("span",null,fdate(i.updated)));
    m.appendChild(meta);
    m.onclick=function(){openSheet(i)};
    r.appendChild(m);
    var p=el("div","prices");
    p.appendChild(el("i",null,"банк"));p.appendChild(el("b",null,fmt(i.bank)));
    p.appendChild(el("i",null,"нал"));p.appendChild(el("b",null,fmt(i.cash)));
    r.appendChild(p);
    var s=el("button","stock",i.inStock?"Есть":"Нет");s.type="button";
    s.setAttribute("aria-label",i.name+(i.mem?" "+i.mem:"")+": "+(i.inStock?"есть, нажмите чтобы отметить «нет»":"нет, нажмите чтобы отметить «есть»"));
    s.onclick=function(){mutate(i.id,{inStock:!i.inStock})};
    r.appendChild(s);
    return r;
  }

  var tt;
  function toast(t){var e=$("toast");e.textContent=t;e.hidden=false;clearTimeout(tt);tt=setTimeout(function(){e.hidden=true},4000)}

  // ---------- edit sheet ----------
  function setStock(v){
    stockDraft=v;
    $("tY").setAttribute("aria-pressed",String(v));$("tN").setAttribute("aria-pressed",String(!v));
  }
  function fillSections(t,cur){
    var s=$("fSec");s.textContent="";
    var secs=sectionsOf(t);
    secs.forEach(function(n){var o=el("option",null,n);o.value=n;s.appendChild(o)});
    var o=el("option",null,"+ Новый раздел");o.value="__new__";s.appendChild(o);
    s.value=cur&&secs.indexOf(cur)>=0?cur:(secs[0]||"__new__");
    $("newSecBox").hidden=s.value!=="__new__";
  }
  function openSheet(i){
    editing=i||null;delArmed=false;
    var t=i?i.tab:(tab||tabList()[0]||"Apple");
    $("shT").textContent=i?"Изменить товар":"Новый товар · "+t;
    $("fName").value=i?i.name:"";$("fMem").value=i?(i.mem||""):"";
    $("fBank").value=i?String(i.bank):"";$("fCash").value=i?String(i.cash):"";
    $("fNewSec").value="";
    fillSections(t,i&&i.section);
    setStock(i?i.inStock:true);
    $("bDel").hidden=!i;$("bDel").textContent="Удалить";$("bDel").classList.remove("sure");
    $("sheet").dataset.tab=t;
    $("sheet").hidden=false;
    setTimeout(function(){$(i?"fBank":"fName").focus()},50);
  }
  function closeSheet(){$("sheet").hidden=true;editing=null}

  $("fSec").onchange=function(){$("newSecBox").hidden=this.value!=="__new__"};
  $("tY").onclick=function(){setStock(true)};$("tN").onclick=function(){setStock(false)};
  $("bCancel").onclick=closeSheet;
  $("sheet").addEventListener("click",function(e){if(e.target===this)closeSheet()});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!$("sheet").hidden)closeSheet()});
  $("add").onclick=function(){openSheet(null)};

  $("bDel").onclick=function(){
    if(!editing)return;
    if(!delArmed){delArmed=true;this.textContent="Точно удалить?";this.classList.add("sure");return}
    var id=editing.id;closeSheet();removeItem(id);
  };

  $("bSave").onclick=function(){
    var name=$("fName").value.trim();
    if(!name){toast("Впишите название модели");$("fName").focus();return}
    var t=$("sheet").dataset.tab,sec=$("fSec").value;
    if(sec==="__new__"){sec=$("fNewSec").value.trim();if(!sec){toast("Впишите название раздела");$("fNewSec").focus();return}}
    var rec={name:name,mem:$("fMem").value.trim(),section:sec,bank:num($("fBank").value),cash:num($("fCash").value),inStock:stockDraft};
    if(editing){
      var o=editing,id=o.id;
      var changed=Object.keys(rec).some(function(k){return rec[k]!==(o[k]===undefined?"":o[k])});
      closeSheet();
      if(changed)mutate(id,rec);
    }else{
      var sectionItems=items.filter(function(i){return i.tab===t&&i.section===sec}),ord;
      if(sectionItems.length)ord=Math.max.apply(null,sectionItems.map(function(i){return i.ord}))+1;
      else ord=Math.max.apply(null,[0].concat(items.map(function(i){return i.ord})))+10;
      rec.tab=t;rec.ord=ord;
      closeSheet();createItem(rec);
    }
  };

  // ---------- filters, search ----------
  $("sAll").onclick=function(){filter="all";render()};
  $("sIn").onclick=function(){filter="in";render()};
  $("sOut").onclick=function(){filter="out";render()};
  var qt;$("q").addEventListener("input",function(){var v=this.value;clearTimeout(qt);qt=setTimeout(function(){query=v.trim();render()},120)});

  // ---------- refresh: on open, every 20 s, when the app comes back to the screen ----------
  function refresh(){if(!document.hidden&&!pending&&$("sheet").hidden&&$("gate").hidden)load()}
  setInterval(refresh,20000);
  document.addEventListener("visibilitychange",refresh);
  window.addEventListener("focus",refresh);
  window.addEventListener("online",refresh);

  render();
  load();
})();

</script>
</body>
</html>
